<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY.

  A Frappe bench in development serves plain HTTP (http://<site>:8001), which
  Android 9+ blocks by default. This config re-allows cleartext for local
  development hosts only — production traffic stays HTTPS-only, and this file
  is never packaged into a release build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">edupulse.local</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
