<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Never merged into a release APK — the only manifest that
  references this file is android/app/src/debug/AndroidManifest.xml.

  A Frappe bench in development serves plain HTTP, which Android 9+ blocks by
  default. The earlier version of this file listed hosts individually
  (localhost, 10.0.2.2, edupulse.local, 127.0.0.1). That covers an emulator and
  an `adb reverse` tunnel, but NOT a real phone reaching the developer's
  machine over wifi at an address like http://10.40.84.8:8001 — Android refuses
  that connection before a packet leaves the device, and the app then reports
  it identically to a wrong address or a stopped server.

  Android's <domain> element takes literal hosts, not CIDR ranges, so no list
  of entries can cover "whatever address this laptop has on this network
  today". A permissive base-config states the real rule directly: in a debug
  build, plain HTTP to any host is allowed. Release builds are unaffected and
  remain HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
